APP_NAME=Event Registration API
ENVIRONMENT=development
SSE_POLL_INTERVAL_SECONDS=1.0
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=events@example.local
NOTIFICATION_POLL_INTERVAL_SECONDS=2.0
NOTIFICATION_CLAIM_TIMEOUT_SECONDS=60.0
NOTIFICATION_BATCH_SIZE=20
REMINDER_LEAD_HOURS=24
DATABASE_URL=postgresql+psycopg://event_registration:event_registration@localhost:5432/event_registration
